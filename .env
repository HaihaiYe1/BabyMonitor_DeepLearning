# ===========================================
# Baby Monitor 前端环境变量配置
# ===========================================

# API 配置
API_BASE_URL=http://localhost:8000
WS_BASE_URL=ws://localhost:8000

# 局域网IP配置（mac桌面测试用，修改为你的本机IP）
LOCAL_IP=192.168.1.24

# 应用配置
APP_NAME=Baby Monitor
APP_VERSION=1.0.0
DEBUG=true

# 功能开关
ENABLE_NOTIFICATIONS=true
ENABLE_VIBRATION=true
ENABLE_SOUND=true

# 视频配置
VIDEO_QUALITY=high
VIDEO_FPS=30

# 音频配置
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1

# WebSocket 配置
WS_RECONNECT_DELAY=5
WS_MAX_RECONNECT_ATTEMPTS=10

# 日志配置
LOG_LEVEL=debug
LOG_TO_FILE=true
